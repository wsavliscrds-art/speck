# O app funciona SEM nenhuma chave (usa OpenStreetMap/Overpass).
# As chaves abaixo são OPCIONAIS e GRÁTIS — ativam fontes extras que rodam em
# paralelo e deixam a busca bem mais confiável (fim do "servidor ocupado").
# No Vercel: Settings > Environment Variables. Depois faça Redeploy.

# --- Geoapify (mesmos dados do OSM, servidor estável) ---
# Chave grátis, sem cartão: https://myprojects.geoapify.com  (3.000 buscas/dia)
# Vai no NAVEGADOR (é feita para isso). Restrinja ao seu domínio no painel Geoapify.
VITE_GEOAPIFY_KEY=

# --- Foursquare (base focada em comércios) ---
# Chave grátis: https://foursquare.com/developers/  (crie um projeto/Service Key)
# Fica só no SERVIDOR (função /api/foursquare), nunca no navegador.
FOURSQUARE_KEY=
