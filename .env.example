# === Credenciais do Apple Maps (MapKit JS) ===
# Pegue tudo na sua conta Apple Developer:
#   1. Certificates, Identifiers & Profiles > Keys > (+) > marque "MapKit JS"
#   2. Baixe o arquivo AuthKey_XXXXXXXXXX.p8 (só dá pra baixar uma vez!)
#   3. Anote o Key ID (10 caracteres) e o seu Team ID (canto superior direito)

# Team ID da sua conta Apple Developer (10 caracteres)
MAPKIT_TEAM_ID=XXXXXXXXXX

# Key ID da chave MapKit JS (10 caracteres)
MAPKIT_KEY_ID=YYYYYYYYYY

# Conteúdo do arquivo .p8, incluindo as linhas BEGIN/END.
# Em uma linha só, troque as quebras por \n. Ex.:
# MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
MAPKIT_PRIVATE_KEY=

# (opcional) trava o token a um domínio, ex.: https://seuapp.vercel.app
# MAPKIT_ORIGIN=

# === Só para desenvolvimento local com `npm run dev` (sem vercel dev) ===
# Cole um token MapKit JS já pronto para testar rápido, sem assinar no servidor.
# VITE_MAPKIT_TOKEN=
