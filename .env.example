# Porta do backend/API
PORT=4000

# Endereço da API do scraper google-maps-scraper.
# No docker-compose use http://scraper:8080; rodando local use http://localhost:8080
SCRAPER_BASE_URL=http://localhost:8080

# Caminho do banco de leads (SQLite)
DB_PATH=./data/leads.db

# Idioma padrão das buscas no Maps (pt = português)
DEFAULT_LANG=pt

# Origem permitida no CORS (* libera geral; em produção use a URL do seu painel)
CORS_ORIGIN=*
